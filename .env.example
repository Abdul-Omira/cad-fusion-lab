# Environment Configuration for CAD Fusion Lab
# Copy this file to .env and update with your values

# === Application Settings ===
# Device to run model on (cuda, cpu, or mps for Apple Silicon)
DEVICE=cpu

# Logging level (debug, info, warning, error, critical)
LOG_LEVEL=info

# === Security Settings ===
# IMPORTANT: Change this in production! Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-long-random-string

# Access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Valid API keys (comma-separated, leave empty to disable API key auth)
VALID_API_KEYS=

# === CORS Settings ===
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# === Model Settings ===
MODEL_PATH=checkpoints/final_model.pt
CONFIG_PATH=configs/base_config.yaml
OUTPUT_DIR=outputs/api

# === Redis Settings ===
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# === Database Settings (if using PostgreSQL for job storage) ===
# DATABASE_URL=postgresql://user:password@localhost:5432/cad_fusion_lab

# === Monitoring Settings ===
# Enable Prometheus metrics
PROMETHEUS_ENABLED=true

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# Weights & Biases API key (for training)
# WANDB_API_KEY=your-wandb-api-key
# WANDB_PROJECT=cad-fusion-lab
# WANDB_ENTITY=your-entity

# === Server Settings ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4
SERVER_RELOAD=false

# === Training Settings ===
# Training device and precision
TRAINING_DEVICE=cuda
MIXED_PRECISION=true
GRADIENT_ACCUMULATION_STEPS=1

# === Cloud Storage (optional) ===
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET=cad-models

# === Docker Compose Settings ===
# Grafana admin password
GRAFANA_PASSWORD=admin
